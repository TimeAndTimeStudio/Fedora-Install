#!/usr/bin/env bash

set -e

echo "Configuring dnf..."
echo "install_weak_deps=False" | tee -a /etc/dnf/dnf.conf

echo "Installing base packages..."
dnf install -y \
    gdm \
    wget \
    gnome-terminal \
    nautilus \
    google-noto-sans-thai-fonts \
    google-noto-sans-cjk-fonts \
    tar \
    google-noto-serif-cjk-fonts \
    google-noto-serif-thai-fonts \
    pipewire-pulseaudio \
    nodejs \
    npm \
    libayatana-appindicator-gtk3

echo "Removing unneeded packages..."
dnf remove -y \
    gnome-tour \
    malcontent-control \
    gnome-remote-desktop \
    vim-minimal


echo "Installing Plymouth theme..."
dnf install -y plymouth-system-theme

echo "Setting Plymouth theme (bgrt) and rebuilding initramfs..."
plymouth-set-default-theme -R bgrt

echo "Installing Steam..."
echo "Steam: installing 32-bit dependencies..."
dnf install glibc.i686 mesa-libGL.i686 libdrm.i686 libnsl.i686 tar -y
echo "Steam: downloading files..."
wget https://repo.steampowered.com/steam/archive/stable/steam_latest-stable.tar.gz
wget https://github.com/TimeAndTimeStudio/Fedora-Install/raw/refs/heads/main/steam/icons.tar.xz

echo "Steam: extracting launcher..."
tar -xvf steam_latest-stable.tar.gz
cd steam-launcher
echo "Steam: installing launcher and desktop entry..."
rm steam
mv bin_steam.sh steam
mv steam /usr/bin/
mkdir -p /home/timeandtime/.local/share/applications
mv steam.desktop /home/timeandtime/.local/share/applications/steam.desktop
chmod +x /home/timeandtime/.local/share/applications/steam.desktop
mkdir /usr/lib/steam
mv bootstraplinux_ubuntu12_32.tar.xz /usr/lib/steam/
cd ../
echo "Steam: installing icons..."
tar -xvf icons.tar.xz
cp -r icons/* /usr/share/icons/hicolor/
echo "Steam: cleaning up..."
rm icons.tar.xz steam_latest-stable.tar.gz
rm -r steam-launcher icons

echo "Installing Brave Origin..."
echo "Brave: adding repository..."
dnf config-manager addrepo --from-repofile=https://brave-browser-rpm-release.s3.brave.com/brave-browser.repo
echo "Brave: installing package..."
dnf install brave-origin -y

echo "Installing Wallpaper..."
wget https://github.com/TimeAndTimeStudio/Fedora-Install/releases/download/App-id-1/019b913a-a484-7237-b907-2444e37e22e2.png
wget https://github.com/TimeAndTimeStudio/Fedora-Install/releases/download/App-id-1/horizontal.pic.jpg
echo "Wallpaper: moving files to /home/timeandtime..."
mv 019b913a-a484-7237-b907-2444e37e22e2.png horizontal.pic.jpg /home/timeandtime/
chown timeandtime:timeandtime /home/timeandtime/019b913a-a484-7237-b907-2444e37e22e2.png /home/timeandtime/horizontal.pic.jpg

echo "Installing Spotify..."

# Extract data.tar.* from a .deb (an "ar" archive) using only bash, coreutils and tar.
# usage: extract_deb_data <file.deb> <dest-dir>
extract_deb_data() {
    local deb=$1 dest=$2 offset=8 total hdr name size flag
    local LC_ALL=C

    total=$(stat -c %s "$deb")

    if [[ "$(head -c 8 "$deb")" != '!<arch>' ]]; then
        echo "ERROR: not a .deb (ar) file: $deb" >&2
        return 1
    fi

    while (( offset + 60 <= total )); do
        hdr=$(dd if="$deb" bs=1 skip="$offset" count=60 2>/dev/null)
        name=${hdr:0:16}; name=${name%% *}; name=${name%/}
        size=${hdr:48:10}; size=${size%% *}
        offset=$(( offset + 60 ))

        if [[ $name == data.tar* ]]; then
            # GNU tar cannot auto-detect compression when reading from a pipe
            case $name in
                data.tar)     flag=() ;;
                data.tar.xz)  flag=(-J) ;;
                data.tar.gz)  flag=(-z) ;;
                data.tar.zst) flag=(--zstd) ;;
                data.tar.bz2) flag=(-j) ;;
                *)
                    echo "ERROR: unsupported archive: $name" >&2
                    return 1
                    ;;
            esac

            dd if="$deb" bs=1M iflag=skip_bytes,count_bytes \
                skip="$offset" count="$size" 2>/dev/null \
                | tar -x "${flag[@]}" -f - -C "$dest"
            return
        fi

        offset=$(( offset + size + size % 2 ))
    done

    echo "ERROR: data.tar.* not found in $deb" >&2
    return 1
}

echo "==> Preparing Spotify working directories..."
BASE_URL="https://repository.spotify.com"
DIST="stable"
PACKAGES_PATH="dists/$DIST/non-free/binary-amd64/Packages"

WORK_DIR="${1:-$PWD/spotify-download}"
TMP_DIR="$(mktemp -d)"

mkdir -p "$WORK_DIR"

PACKAGES="$TMP_DIR/Packages"
DEB="$TMP_DIR/spotify.deb"
ROOT_DIR="$TMP_DIR/root"

cleanup() {
    rm -rf "$TMP_DIR"
}
trap cleanup EXIT

echo "==> Downloading official Spotify package metadata..."

curl -fL --retry 3 \
    "$BASE_URL/$PACKAGES_PATH" \
    -o "$PACKAGES"

echo "==> Finding latest Spotify package..."

PACKAGE_INFO="$(
    awk '
        /^Package: spotify-client$/ {
            found=1
            block=""
        }

        found {
            block = block $0 "\n"
        }

        found && /^$/ {
            print block
            exit
        }
    ' "$PACKAGES"
)"

VERSION="$(printf '%s\n' "$PACKAGE_INFO" | sed -n 's/^Version: //p')"
FILENAME="$(printf '%s\n' "$PACKAGE_INFO" | sed -n 's/^Filename: //p')"
SHA256="$(printf '%s\n' "$PACKAGE_INFO" | sed -n 's/^SHA256: //p')"
SHA512="$(printf '%s\n' "$PACKAGE_INFO" | sed -n 's/^SHA512: //p')"

if [[ -z "$VERSION" || -z "$FILENAME" || -z "$SHA256" || -z "$SHA512" ]]; then
    echo "ERROR: Could not read Spotify package metadata."
    exit 1
fi

echo
echo "Spotify version : $VERSION"
echo "Package         : $FILENAME"
echo "SHA256          : $SHA256"
echo "SHA512          : $SHA512"
echo

echo "==> Downloading Spotify .deb..."

curl -fL --retry 3 \
    "$BASE_URL/$FILENAME" \
    -o "$DEB"

echo
echo "==> Verifying SHA256..."

echo "$SHA256  $DEB" | sha256sum -c -

echo
echo "==> Verifying SHA512..."

echo "$SHA512  $DEB" | sha512sum -c -

echo
echo "==> Extracting .deb..."

mkdir -p "$ROOT_DIR/data"

extract_deb_data "$DEB" "$ROOT_DIR/data"

SPOTIFY_DIR="$ROOT_DIR/data/usr/share/spotify"

if [[ ! -d "$SPOTIFY_DIR" ]]; then
    echo "ERROR: /usr/share/spotify was not found."
    exit 1
fi

echo "==> Preparing final output..."

rm -rf "$WORK_DIR/spotify"

mv "$SPOTIFY_DIR" "$WORK_DIR/spotify"

DESKTOP_FILE="$WORK_DIR/spotify/spotify.desktop"

if [[ -f "$DESKTOP_FILE" ]]; then
    echo "==> Updating spotify.desktop..."

    sed -i \
        -e 's|^TryExec=.*|TryExec=/usr/lib/spotify/spotify|' \
        -e 's|^Exec=.*|Exec=/usr/lib/spotify/spotify %U|' \
        "$DESKTOP_FILE"
fi

echo "==> Installing desktop entry..."

mkdir -p /home/timeandtime/.local/share/applications

mv "$WORK_DIR/spotify/spotify.desktop" \
    "/home/timeandtime/.local/share/applications/spotify.desktop"

chmod +x "/home/timeandtime/.local/share/applications/spotify.desktop"

echo "==> Installing icons..."

mv "$WORK_DIR/spotify/icons/spotify-linux-16.png" \
    /usr/share/icons/hicolor/16x16/apps/spotify-client.png

mv "$WORK_DIR/spotify/icons/spotify-linux-22.png" \
    /usr/share/icons/hicolor/22x22/apps/spotify-client.png

mv "$WORK_DIR/spotify/icons/spotify-linux-24.png" \
    /usr/share/icons/hicolor/24x24/apps/spotify-client.png

mv "$WORK_DIR/spotify/icons/spotify-linux-32.png" \
    /usr/share/icons/hicolor/32x32/apps/spotify-client.png

mv "$WORK_DIR/spotify/icons/spotify-linux-48.png" \
    /usr/share/icons/hicolor/48x48/apps/spotify-client.png

mv "$WORK_DIR/spotify/icons/spotify-linux-64.png" \
    /usr/share/icons/hicolor/64x64/apps/spotify-client.png

mv "$WORK_DIR/spotify/icons/spotify-linux-128.png" \
    /usr/share/icons/hicolor/128x128/apps/spotify-client.png

mv "$WORK_DIR/spotify/icons/spotify-linux-256.png" \
    /usr/share/icons/hicolor/256x256/apps/spotify-client.png

mv "$WORK_DIR/spotify/icons/spotify-linux-512.png" \
    /usr/share/icons/hicolor/512x512/apps/spotify-client.png

rm -r "$WORK_DIR/spotify/icons"

echo "==> Installing Spotify..."

mv "$WORK_DIR/spotify" /usr/lib/spotify

echo "==> Removing temporary output..."

rm -r "$WORK_DIR"

echo
echo "Done."
echo
echo "Spotify version:"
echo "  $VERSION"
echo
echo "Installed:"
echo "  /usr/lib/spotify/spotify"
echo "  /home/timeandtime/.local/share/applications/spotify.desktop"
echo
echo "Temporary files have been removed."



echo "Installing npm global packages..."
echo "npm: tmg-studio"
npm install -g tmg-studio
echo "npm: tma-agent"
npm install -g tma-agent

echo "Setting default target to graphical..."
systemctl set-default graphical.target

echo "Fixing ownership of /home/timeandtime/.local..."
chown -R timeandtime:timeandtime /home/timeandtime/.local

echo "Updating icon cache..."
gtk-update-icon-cache -f /usr/share/icons/hicolor

echo "Configuring GRUB (hidden, no timeout)..."
sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=0/' /etc/default/grub
sed -i '1i GRUB_TIMEOUT_STYLE=hidden' /etc/default/grub

echo "Regenerating GRUB config..."
grub2-mkconfig -o /boot/grub2/grub.cfg

echo
echo "All done."
